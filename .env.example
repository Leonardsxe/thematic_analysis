# Thematic Analysis Platform Configuration
# =========================================

# --- Database & Storage ---
# SQLite is used by default. Change to postgresql://user:pass@host:port/db if needed.
DB_URL=sqlite:///./thematic.db

# Directory where ChromaDB stores vector embeddings.
CHROMA_PATH=./chroma_store

# --- Embedding Model ---
# Local multilingual model for Spanish/English similarity.
# Options: 
#   - paraphrase-multilingual-MiniLM-L12-v2 (Fast, 118MB)
#   - paraphrase-multilingual-mpnet-base-v2 (High quality, 278MB)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Force "cpu" if your GPU is not supported by PyTorch (e.g. older NVIDIA cards)
# or leave empty for automatic detection (cuda/cpu).
EMBEDDING_DEVICE=

# --- AI Models (Tier 1: Local via Ollama) ---
# Used for interactive coding suggestions.
OLLAMA_MODEL=mistral:7b
OLLAMA_HOST=http://localhost:11434

# --- AI Models (Tier 2: Cloud via Anthropic) ---
# Used for theme synthesis and cross-corpus analysis.
# Requires: pip install anthropic
USE_CLAUDE=False
ANTHROPIC_API_KEY=your_api_key_here

# --- User settings ---
DEFAULT_ANALYST=analyst_name
